# Copiar este archivo como .env.local y completar con las claves reales
# (Dashboard de Stripe → Entwickler/innen → API-Schlüssel).
# .env.local NUNCA se sube a git (ya está en .gitignore).

# Clave pública (empieza con pk_test_ en modo prueba, pk_live_ en producción)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Clave secreta (empieza con sk_test_ en modo prueba, sk_live_ en producción)
# NUNCA compartir esta clave, ni en el chat, ni en el código, ni en git.
STRIPE_SECRET_KEY=

# URL base del sitio, usada para las URLs de éxito/cancelación de Stripe
NEXT_PUBLIC_SITE_URL=http://localhost:3412
